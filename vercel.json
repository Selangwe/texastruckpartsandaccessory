{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/product/:slug/",
      "destination": "/product.html"
    },
    {
      "source": "/product/:slug",
      "destination": "/product.html"
    },
    {
      "source": "/product-category/:slug/",
      "destination": "/category.html"
    },
    {
      "source": "/product-category/:slug",
      "destination": "/category.html"
    },
    {
      "source": "/shop/",
      "destination": "/category.html"
    },
    {
      "source": "/shop",
      "destination": "/category.html"
    }
  ]
}
