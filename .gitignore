__pycache__/
*.py[cod]
node_modules/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Scraper exports are re-downloadable and large; keep the parsed output, not the raw
# dump. Drop a fresh export here and run `npm run fb:parse`.
data/facebook-export.*
data/*.xlsx

# Signed Facebook CDN URLs — these expire about four days after the scrape, so a
# committed copy is worthless within a week and just carries tracking parameters.
data/facebook-image-urls.txt
data/facebook-image-failures.txt
